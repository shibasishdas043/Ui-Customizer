{
  "manifest_version": 3,
  "name": "Aura · UI Customizer & Startpage",
  "short_name": "Aura",
  "version": "1.0.0",
  "description": "A stunning, minimalist startpage and browser customizer with clock, weather, notes, pomodoro, search, and custom webpage redirects.",
  "action": {
    "title": "Aura · UI Customizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
