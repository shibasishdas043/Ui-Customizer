{
  "manifest_version": 3,
  "name": "Aura · UI Customizer & Startpage",
  "short_name": "Aura",
  "version": "1.0.0",
  "description": "A stunning, minimalist startpage with dynamic wallpapers, clock, weather, custom search, and personal productivity tools.",
  "action": {
    "title": "Aura · UI Customizer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://services.bonjourr.fr/*",
    "https://images.unsplash.com/*",
    "https://unsplash.com/*",
    "https://wallhaven.cc/*",
    "https://www.bing.com/*",
    "https://bing.biturl.top/*",
    "https://*.reddit.com/*",
    "https://*.redd.it/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://ipapi.co/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
